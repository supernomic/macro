  "query": "\n            SELECT id, org_id, provider, display_name, credential_ref,\n                   last_synced_at, last_cursor, created_at\n            FROM lifecycle_connector_accounts\n            WHERE org_id IS NOT DISTINCT FROM $1\n              AND ($2::text IS NULL OR provider = $2)\n            ORDER BY created_at\n            ",
