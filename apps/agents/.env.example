# Which Macro backend to talk to: local | dev | prod
MACRO_ENV=local

# Agent bearer token (mat_...) for the super agent principal, minted via
# Macro's agent-identity admin API. Scopes on this token are the capability
# boundary for the super agent's tools.
MACRO_SUPER_AGENT_TOKEN=

# Base URL of the service hosting the agent-ledger API
# (document-cognition-service). Defaults follow MACRO_ENV.
# MACRO_LEDGER_BASE_URL=http://localhost:8085

# Model + composition pin for the super agent.
# MACRO_SUPER_AGENT_MODEL=anthropic/claude-sonnet-4-6
# MACRO_SUPER_AGENT_COMPOSITION_ID=super-agent/v1

# Domain agent principal tokens (mat_...). Each domain agent has its own
# principal whose scopes are the domain's tool allowlist; leaving a token
# unset disables that domain agent entirely.
MACRO_TECHOPS_AGENT_TOKEN=

# Escalations: public base URL of this service (used to build the resume
# callback URL Macro calls when an expert resolves an escalation), and the
# shared bearer token Macro presents on that callback (must match
# ESCALATION_CALLBACK_TOKEN on the document-cognition-service).
# AGENTS_PUBLIC_URL=http://localhost:3000
# ESCALATION_CALLBACK_TOKEN=
# (also authenticates /callbacks/approvals/:conversationId)

# Model provider credentials (Pi providers; see flueframework.com/docs/guide/models/)
ANTHROPIC_API_KEY=

# Slack: inbound verification + outbound Web API.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Slack listening modes: default for unlisted channels
# (mentions_only | proactive | silent) and a per-channel JSON override map.
# SLACK_DEFAULT_CHANNEL_MODE=mentions_only
# SLACK_CHANNEL_MODES={"C0123456789":"proactive"}

# Evals: Braintrust traces join ledger rows via composition_id + conversation
# id. Leave unset to skip export. Never send secrets or document bodies.
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT_NAME=macro-agents

# OpenTelemetry GenAI spans (content-free). Leave unset to skip.
# OTEL_EXPORTER_OTLP_ENDPOINT=
