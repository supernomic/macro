# Which Macro backend to talk to: local | dev | prod
MACRO_ENV=local

# Agent bearer token (mat_...) for the super agent principal, minted via
# Macro's agent-identity admin API. Scopes on this token are the capability
# boundary for the super agent's tools.
MACRO_SUPER_AGENT_TOKEN=

# Base URL of the service hosting the agent-ledger API
# (document-cognition-service). Defaults follow MACRO_ENV.
# MACRO_LEDGER_BASE_URL=http://localhost:8085

# Model + composition pin for the super agent.
# MACRO_SUPER_AGENT_MODEL=anthropic/claude-sonnet-4-6
# MACRO_SUPER_AGENT_COMPOSITION_ID=super-agent/v1

# Model provider credentials (Pi providers; see flueframework.com/docs/guide/models/)
ANTHROPIC_API_KEY=

# Slack: inbound verification + outbound Web API.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Slack listening modes: default for unlisted channels
# (mentions_only | proactive | silent) and a per-channel JSON override map.
# SLACK_DEFAULT_CHANNEL_MODE=mentions_only
# SLACK_CHANNEL_MODES={"C0123456789":"proactive"}
